<div class="app-empty-state" role="status">
    <FluentIcon Value="@(Icon ?? new Icons.Regular.Size48.DocumentDismiss())" Color="Color.Disabled" aria-hidden="true" />
    <h2 class="app-empty-state__title">@Title</h2>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="app-empty-state__message">@Message</p>
    }
    @if (Actions is not null)
    {
        <div class="app-empty-state__actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Message { get; set; }
    [Parameter] public Icon? Icon { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
