@using ApexCharts

<WidgetCard Title="Bug Trend">
    @if (_loading)
    {
        <div class="widget-center"><FluentSpinner Label="Loading bug trend" /></div>
    }
    else if (_points.Count > 0)
    {
        <ApexChart @key="_chartKey" TItem="BugTrendPoint" Options="_options" Height="@("100%")">
            <ApexPointSeries TItem="BugTrendPoint" Items="_points" Name="Created" SeriesType="SeriesType.Line" XValue="@(p => p.Date.ToString("MMM d"))" YValue="@(p => (decimal)p.Created)" />
            <ApexPointSeries TItem="BugTrendPoint" Items="_points" Name="Resolved" SeriesType="SeriesType.Line" XValue="@(p => p.Date.ToString("MMM d"))" YValue="@(p => (decimal)p.Resolved)" />
        </ApexChart>
    }
    else
    {
        <div class="widget-empty">No bug data for this sprint</div>
    }
</WidgetCard>

@code {
    [Parameter] public int? SprintId { get; set; }
    [CascadingParameter(Name = "IsDarkMode")] public bool IsDarkMode { get; set; }
    [Inject] private MetricsDashboardService MetricsSvc { get; set; } = default!;
    [Inject] private ILogger<BugTrendWidget> Logger { get; set; } = default!;

    private List<BugTrendPoint> _points = [];
    private ApexChartOptions<BugTrendPoint> _options = new();
    private bool _loading = true;
    private int? _lastSprintId = -1;
    private bool? _lastTheme;
    private int _chartKey;

    protected override async Task OnParametersSetAsync()
    {
        var themeChanged = _lastTheme != IsDarkMode;
        if (_lastSprintId == SprintId && !themeChanged) return;
        _lastSprintId = SprintId;
        _lastTheme = IsDarkMode;
        _loading = true;
        try { _points = SprintId.HasValue ? await MetricsSvc.GetBugTrendAsync(SprintId.Value) : []; }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to load bug trend for sprint {SprintId}", SprintId); _points = []; }
        _options = BuildOptions(IsDarkMode);
        _chartKey++;
        _loading = false;
    }

    private static ApexChartOptions<BugTrendPoint> BuildOptions(bool isDark) => new()
    {
        Theme = MetricsChartTheme.Theme(isDark),
        Chart = new Chart { Background = "transparent", Toolbar = new Toolbar { Show = false } },
        Colors = ["#ef5350", "#22c55e"],
        Stroke = new Stroke { Curve = [Curve.Smooth, Curve.Smooth], Width = [2, 2] },
        Xaxis = new XAxis { Labels = new XAxisLabels { Style = MetricsChartTheme.AxisLabelStyle(isDark) } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Style = MetricsChartTheme.AxisLabelStyle(isDark) } }],
        Grid = new Grid { BorderColor = MetricsChartTheme.GridLine(isDark), Row = new GridRow { Colors = ["transparent"] } },
        Legend = new Legend { Labels = MetricsChartTheme.LegendLabels(isDark), Position = LegendPosition.Top },
        Tooltip = MetricsChartTheme.Tooltip(isDark)
    };
}
