@using ApexCharts

<WidgetCard Title="Cycle Time">
    @if (_loading)
    {
        <div class="widget-center"><FluentSpinner Label="Loading cycle time" /></div>
    }
    else if (_points.Count > 0)
    {
        <ApexChart @key="_chartKey" TItem="CycleTimePoint" Options="_options" Height="@("100%")">
            <ApexPointSeries TItem="CycleTimePoint" Items="_points" Name="Avg Days" SeriesType="SeriesType.Line" XValue="@(p => p.Date.ToString("MMM d"))" YValue="@(p => (decimal)Math.Round(p.AverageDays, 1))" />
        </ApexChart>
    }
    else
    {
        <div class="widget-empty">No cycle time data yet</div>
    }
</WidgetCard>

@code {
    [Parameter] public int? SprintId { get; set; }
    [CascadingParameter(Name = "IsDarkMode")] public bool IsDarkMode { get; set; }
    [Inject] private MetricsDashboardService MetricsSvc { get; set; } = default!;
    [Inject] private ILogger<CycleTimeWidget> Logger { get; set; } = default!;

    private List<CycleTimePoint> _points = [];
    private ApexChartOptions<CycleTimePoint> _options = new();
    private bool _loading = true;
    private int? _lastSprintId = -1;
    private bool? _lastTheme;
    private int _chartKey;

    protected override async Task OnParametersSetAsync()
    {
        var themeChanged = _lastTheme != IsDarkMode;
        if (_lastSprintId == SprintId && !themeChanged) return;
        _lastSprintId = SprintId;
        _lastTheme = IsDarkMode;
        _loading = true;
        try { _points = SprintId.HasValue ? await MetricsSvc.GetCycleTimeDataAsync(SprintId.Value) : []; }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to load cycle time for sprint {SprintId}", SprintId); _points = []; }
        _options = BuildOptions(IsDarkMode);
        _chartKey++;
        _loading = false;
    }

    private static ApexChartOptions<CycleTimePoint> BuildOptions(bool isDark) => new()
    {
        Theme = MetricsChartTheme.Theme(isDark),
        Chart = new Chart { Background = "transparent", Toolbar = new Toolbar { Show = false } },
        Colors = ["#ab47bc"],
        Stroke = new Stroke { Curve = [Curve.Smooth], Width = [3] },
        Markers = new Markers { Size = 4 },
        Xaxis = new XAxis { Labels = new XAxisLabels { Style = MetricsChartTheme.AxisLabelStyle(isDark) } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Style = MetricsChartTheme.AxisLabelStyle(isDark), Formatter = "function(val) { return val != null ? val.toFixed(1) + 'd' : ''; }" } }],
        Grid = new Grid { BorderColor = MetricsChartTheme.GridLine(isDark), Row = new GridRow { Colors = ["transparent"] } },
        Legend = new Legend { Labels = MetricsChartTheme.LegendLabels(isDark), Position = LegendPosition.Top },
        Tooltip = MetricsChartTheme.Tooltip(isDark)
    };
}
