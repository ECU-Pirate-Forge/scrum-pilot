@inject HttpClient Http
@inject ILogger<ProjectRepositorySettings> Logger

<section aria-label="Repository configuration">
    <h2>Repository and scope enforcement</h2>
    <p>One GitHub repository per project. Repository contents are read-only; Checks write permission publishes file-scope validation. Private source uses local Ollama only.</p>
    <p role="status">@(_status?.AppConfigured == true ? "GitHub App configured" : "Not configured: an operator must configure the API's GitHub App secrets")</p>
    <p>@_status?.EnforcementStatus</p>
    <p>@(_status?.WebhookConfigured == true ? "Webhook secret configured; delivery must be verified in GitHub." : "Webhook not configured: automatic PR revalidation is unavailable.")</p>
    @if (_error.Length > 0) { <p role="alert">@_error</p> }
    <fieldset disabled="@(!IsOwner || _saving)">
        <legend>Organization Owner settings</legend>
        <label>GitHub repository ID <input type="number" @bind="_repositoryId" /></label>
        <label>Installation ID <input type="number" @bind="_installationId" /></label>
        <label>Owner <input @bind="_owner" /></label>
        <label>Repository name <input @bind="_name" /></label>
        <label>Default branch <input @bind="_branch" /></label>
        <FluentButton OnClick="SaveAsync" Disabled="@(!IsOwner || _saving)">Verify and save repository</FluentButton>
    </fieldset>
</section>

@code {
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public bool IsOwner { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    private ProjectRepositoryStatus? _status;
    private long _repositoryId, _installationId, _version;
    private string _owner = "", _name = "", _branch = "main", _error = "";
    private bool _saving;
    private int _loadedProject;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProject == ProjectId) return;
        _loadedProject = ProjectId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var project = ProjectId;
            var status = await Http.GetFromJsonAsync<ProjectRepositoryStatus>($"api/projects/{project}/repository");
            if (project != ProjectId) return;
            _status = status;
            var repository = _status?.Repository;
            _repositoryId = repository?.GitHubRepositoryId ?? 0; _installationId = repository?.InstallationId ?? 0;
            _owner = repository?.Owner ?? ""; _name = repository?.Name ?? ""; _branch = repository?.DefaultBranch ?? "main";
            _version = repository?.Version ?? 0;
        }
        catch (HttpRequestException ex) { Logger.LogWarning(ex, "Repository settings failed to load"); _error = "Unable to load repository settings."; }
    }

    private async Task SaveAsync()
    {
        _saving = true; _error = "";
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/projects/{ProjectId}/repository",
                new ConfigureProjectRepositoryRequest(_repositoryId, _installationId, _owner, _name, _branch, _version));
            if (!response.IsSuccessStatusCode) { _error = await response.Content.ReadAsStringAsync(); return; }
            await LoadAsync(); await OnSaved.InvokeAsync();
        }
        catch (HttpRequestException ex) { Logger.LogWarning(ex, "Repository settings save failed"); _error = "Unable to verify repository access."; }
        finally { _saving = false; }
    }
}
