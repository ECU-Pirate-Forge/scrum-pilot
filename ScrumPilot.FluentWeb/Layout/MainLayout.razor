@inherits LayoutComponentBase
@implements IDisposable

<FluentLayout HeaderSticky="true">
    <FluentLayoutItem Area="LayoutArea.Header" Class="sp-header" Style="height: 85px">
        <FluentLayoutHamburger />
        <a href="" class="sp-brand-link" aria-label="ScrumPilot home">
            <img src="images/scrumpilot-logo-transparent.svg" alt="ScrumPilot" style="height: 75px; width: auto;" />
        </a>
        <FluentSpacer />
        @if (_organizations.Any())
        {
            <FluentMenu>
                <FluentMenuButton Appearance="ButtonAppearance.Transparent"
                                  Class="sp-header-button sp-header-button--selection"
                                  IconStart="@(new Icons.Regular.Size20.Building().WithColor("currentColor"))"
                                  Title="Select organization"
                                  aria-label="@($"Select organization: {OrganizationState.SelectedOrganization?.Name ?? "none"}")">
                    <span class="sp-selection-label">@(OrganizationState.SelectedOrganization?.Name ?? "Select Organization")</span>
                </FluentMenuButton>
                <FluentMenuList>
                    @foreach (var organization in _organizations)
                    {
                        var item = organization;
                        <FluentMenuItem Role="MenuItemRole.Radio"
                                        Checked="@(OrganizationState.SelectedOrganizationId == item.OrganizationId)"
                                        CheckedChanged="@(selected => selected == true ? SelectOrganizationAsync(item) : Task.CompletedTask)">@item.Name</FluentMenuItem>
                    }
                </FluentMenuList>
            </FluentMenu>
        }
        @if (_appBarProjects.Any())
        {
            <FluentMenu>
                <FluentMenuButton Appearance="ButtonAppearance.Outline"
                                  Class="sp-header-button sp-header-button--project sp-header-button--selection"
                                  IconStart="@(new Icons.Regular.Size20.Folder().WithColor("currentColor"))"
                                  Title="Select project"
                                  aria-label="@($"Select project: {ProjectState.SelectedProject?.ProjectName ?? "none"}")">
                    <span class="sp-selection-label">@(ProjectState.SelectedProject?.ProjectName ?? "Select Project")</span>
                </FluentMenuButton>
                <FluentMenuList>
                    @foreach (var project in _appBarProjects)
                    {
                        var p = project;
                        <FluentMenuItem Role="MenuItemRole.Radio"
                                        Checked="@(ProjectState.SelectedProjectId == p.ProjectId)"
                                        CheckedChanged="@(selected => selected == true ? SetGlobalProject(p) : Task.CompletedTask)">@p.ProjectName</FluentMenuItem>
                    }
                </FluentMenuList>
            </FluentMenu>
        }
        <FluentSpacer />
        <FluentMenu>
            <FluentMenuButton Appearance="ButtonAppearance.Transparent"
                              Class="sp-header-button"
                              IconOnly="true"
                              IconStart="@(ThemeIcon.WithColor("currentColor"))"
                              Title="Theme"
                              aria-label="Theme" />
            <FluentMenuList>
                <FluentMenuItem Role="MenuItemRole.Radio" Checked="@(Theme.Preference == UiPreference.System)"
                                IconStart="@(new Icons.Regular.Size20.DesktopMac())"
                                CheckedChanged="@(selected => selected == true ? SetThemeAsync(UiPreference.System) : Task.CompletedTask)">System</FluentMenuItem>
                <FluentMenuItem Role="MenuItemRole.Radio" Checked="@(Theme.Preference == UiPreference.Light)"
                                IconStart="@(new Icons.Regular.Size20.WeatherSunny())"
                                CheckedChanged="@(selected => selected == true ? SetThemeAsync(UiPreference.Light) : Task.CompletedTask)">Light</FluentMenuItem>
                <FluentMenuItem Role="MenuItemRole.Radio" Checked="@(Theme.Preference == UiPreference.Dark)"
                                IconStart="@(new Icons.Regular.Size20.WeatherMoon())"
                                CheckedChanged="@(selected => selected == true ? SetThemeAsync(UiPreference.Dark) : Task.CompletedTask)">Dark</FluentMenuItem>
            </FluentMenuList>
        </FluentMenu>
        <FluentAnchorButton Href="user-settings"
                            Appearance="ButtonAppearance.Transparent"
                            Class="sp-header-button"
                            IconOnly="true"
                            IconStart="@(new Icons.Regular.Size20.PersonCircle().WithColor("currentColor"))"
                            Title="User settings"
                            aria-label="User settings" />
        <FluentButton Appearance="ButtonAppearance.Transparent"
                      Class="sp-header-button"
                      IconOnly="true"
                      IconStart="@(new Icons.Regular.Size20.SignOut().WithColor("currentColor"))"
                      Title="Sign out"
                      aria-label="Sign out"
                      OnClick="HandleLogout" />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation">
        <NavMenu />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content" Class="sp-content">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                <CascadingValue Value="Theme.IsDark" Name="IsDarkMode">
                    <CascadingValue @key="_work" Value="_work">
                        <div @key="_work">
                            @if (_routeLoading || _resolvedUri != Navigation.Uri)
                            {
                                <AppLoadingState />
                            }
                            else if (_routeError is not null)
                            {
                                <AppErrorState Title="Organization unavailable" Message="@_routeError" />
                                <a href="organization-management">Organization directory</a>
                            }
                            else if (_needsOrganization)
                            {
                                <p>Choose an organization. Old project-only links cannot identify an organization.</p>
                                @foreach (var organization in _organizations)
                                {
                                    <FluentButton OnClick="@(() => SelectOrganizationAsync(organization))">@organization.Name</FluentButton>
                                }
                            }
                            else
                            {
                                @Body
                            }
                        </div>
                    </CascadingValue>
                </CascadingValue>
            </ChildContent>
            <ErrorContent Context="ex">
                <AppErrorState Title="Something went wrong"
                               Message="@ex.Message"
                               OnRetry="@(() => _errorBoundary?.Recover())" />
            </ErrorContent>
        </ErrorBoundary>
    </FluentLayoutItem>
</FluentLayout>
