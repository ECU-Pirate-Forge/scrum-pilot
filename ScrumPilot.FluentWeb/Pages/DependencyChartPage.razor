@page "/dependency-chart"
@page "/organizations/{OrganizationId:int}/dependency-chart"
@inherits PlanningComponentBase
@using ScrumPilot.FluentWeb.Components.DependencyChart
@inject NavigationManager Nav
@inject ProjectStateService ProjectState
@inject IAppNotificationService Notifications
@inject ILogger<DependencyChartPage> Logger
@inject IProjectWorkClient WorkClient
@implements IAsyncDisposable

<PageTitle>Dependency Chart</PageTitle>

<div class="dependency-chart-page">
    <AppPageHeader Title="Dependency Chart" Subtitle="@HeaderSubtitle">
        <Actions>
            <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.ChevronLeft())" OnClick="@(() => Nav.NavigateTo(OrganizationRoutes.Page(Scope.OrganizationId, "scrum-board", Scope.ProjectId)))">Back to Board</FluentButton>
        </Actions>
    </AppPageHeader>

    @if (_loading)
    {
        <AppLoadingState Message="Loading dependency chart…" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppErrorState Title="Unable to load dependencies" Message="@_error" RetryLabel="Try again" OnRetry="LoadAsync" />
    }
    else
    {
        @if (_graph is not null)
        {
            <p role="status">@WorkClient.Status</p>
            <SprintDependencyView @key="(Scope.OrganizationId, _graph.ProjectId, _graph.SprintId)" CapturedWork="Scope" Graph="_graph" OnChanged="RefreshAsync" />
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "sprintId")] public int? SprintId { get; set; }
    [SupplyParameterFromQuery(Name = "projectId")] public int? ProjectId { get; set; }

    private DependencyGraphDto? _graph;
    private int? _liveProjectId;
    private bool _connectPending;
    private bool _disposed;
    private long _requestId;
    private long _loadGeneration;
    protected override void OnInitialized() => ProjectState.OnChange += ProjectChanged;
    private void ProjectChanged()
    {
        if (!_disposed && !ProjectId.HasValue) _ = InvokeAsync(LoadAsync);
    }
    private bool _loading = true;
    private string _error = string.Empty;
    private string _sprintLabel = string.Empty;
    private int? _loadedSprintId;
    private int? _loadedProjectId;

    private int? EffectiveProjectId => Scope.ProjectId;

    private string HeaderSubtitle => string.IsNullOrWhiteSpace(_sprintLabel)
        ? "Surface cross-team blockers and sequencing issues across the program."
        : _sprintLabel;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedSprintId == SprintId && _loadedProjectId == EffectiveProjectId && !_loading)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_disposed || !Scope.IsCurrent) return;
        var generation = ++_loadGeneration;
        var sprintId = SprintId;
        _loading = true;
        _error = string.Empty;
        _graph = null;
        _loadedSprintId = SprintId;
        _loadedProjectId = EffectiveProjectId;

        try
        {
            if (!EffectiveProjectId.HasValue)
            {
                _error = "Select a project before viewing dependencies.";
                return;
            }

            if (!SprintId.HasValue)
            {
                _error = "Choose a sprint from the Scrum board before viewing its dependency graph.";
                return;
            }
            await FetchGraphAsync();
            if (_disposed || !Scope.IsCurrent || generation != _loadGeneration) return;
            _connectPending = _liveProjectId != EffectiveProjectId;

            if (SprintId.HasValue)
            {
                var sprints = await Http.GetFromJsonAsync<List<Sprint>>($"api/Sprint?projectId={EffectiveProjectId.Value}") ?? [];
                if (_disposed || !Scope.IsCurrent || generation != _loadGeneration) return;
                var sprint = sprints.FirstOrDefault(s => s.SprintId == SprintId.Value);
                _sprintLabel = sprint is null ? $"Sprint {SprintId.Value}" : (sprint.SprintTitle ?? sprint.SprintGoal ?? $"Sprint {sprint.SprintId}");
            }
            else
            {
                _sprintLabel = "All sprints";
            }

        }
        catch (OperationCanceledException) when (!Scope.IsCurrent) { }
        catch (Exception ex)
        {
            if (_disposed || !Scope.IsCurrent || generation != _loadGeneration || sprintId != SprintId) return;
            Logger.LogError(ex, "Failed to load dependency chart for project {ProjectId} sprint {SprintId}", EffectiveProjectId, SprintId);
            _error = "Failed to load PBI data. Please go back and try again.";
            Notifications.ShowError(_error);
        }
        finally
        {
            if (generation == _loadGeneration) _loading = false;
        }
    }

    private async Task FetchGraphAsync()
    {
        var requestId = ++_requestId;
        var project = EffectiveProjectId;
        var sprint = SprintId;
        var graph = await Http.GetFromJsonAsync<DependencyGraphDto>($"api/projects/{project}/sprints/{sprint}/dependency-graph");
        if (Scope.IsCurrent && !_disposed && requestId == _requestId && project == EffectiveProjectId && sprint == SprintId
            && graph is not null && (_graph is null || graph.ProjectId != _graph.ProjectId
                || graph.SprintId != _graph.SprintId || graph.Revision >= _graph.Revision))
            _graph = graph;
    }

    private async Task RefreshAsync()
    {
        if (_disposed || !Scope.IsCurrent || !EffectiveProjectId.HasValue || !SprintId.HasValue) return;
        var sprint = SprintId;
        var generation = _loadGeneration;
        var requestId = _requestId + 1;
        try { await FetchGraphAsync(); if (Scope.IsCurrent && requestId == _requestId && generation == _loadGeneration && sprint == SprintId) _error = ""; }
        catch (OperationCanceledException) when (!Scope.IsCurrent) { }
        catch (HttpRequestException ex)
        {
            if (!Scope.IsCurrent || requestId != _requestId || generation != _loadGeneration || sprint != SprintId) return;
            Logger.LogWarning(ex, "Graph refresh failed");
            _error = "Unable to refresh dependencies. Check project access and retry.";
            _graph = null;
        }
        if (!_disposed && Scope.IsCurrent) await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Scope.IsCurrent || !_connectPending || !EffectiveProjectId.HasValue) return;
        _connectPending = false;
        _liveProjectId = EffectiveProjectId;
        await WorkClient.StartAsync(Scope, () => Scope.IsCurrent ? InvokeAsync(RefreshAsync) : Task.CompletedTask);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true; _requestId++;
        base.Dispose();
        ProjectState.OnChange -= ProjectChanged;
        await WorkClient.StopAsync(Scope);
    }
}
