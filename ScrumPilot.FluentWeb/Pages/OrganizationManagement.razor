@page "/organization-management"
@page "/organizations/{OrganizationId:int}/organization-management"
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@using ScrumPilot.FluentWeb.Components.Organizations
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject OrganizationStateService OrganizationState
@inject ProjectStateService ProjectState
@inject IAppNotificationService Notifications
@inject ILogger<OrganizationManagement> Logger

<PageTitle>Organization Management</PageTitle>

<div class="organization-management-page">
    <AppPageHeader Title="@(_selected?.Name ?? "Organization Management")" Subtitle="Manage organization details, members, project access and lifecycle." />
    @if (OrganizationId == 0)
    {
        <h2>Organization directory</h2>
        @foreach (var organization in _organizations)
        {
            <FluentCard>
                <h3>@organization.Name</h3>
                <FluentAnchorButton Href="@OrganizationRoutes.Page(organization.OrganizationId, "backlog")">Open work</FluentAnchorButton>
                <FluentAnchorButton Href="@OrganizationRoutes.Page(organization.OrganizationId, "organization-management")">Manage organization</FluentAnchorButton>
                @if (_operations.TryGetValue(organization.OrganizationId, out var operation))
                {
                    <p>Storage status: @operation.State</p>
                    @if (operation.Error is not null)
                    {
                        <FluentMessageBar Intent="MessageBarIntent.Warning">Organization storage is unavailable. An administrator can retry provisioning.</FluentMessageBar>
                    }
                    @if (_isAdmin && operation.State is "Failed" or "Provisioning")
                    {
                        <FluentButton data-action="@($"retry-provisioning-{organization.OrganizationId}")" OnClick="@(() => RetryProvisioningAsync(organization.OrganizationId))">Retry provisioning</FluentButton>
                    }
                }
            </FluentCard>
        }
    }

    @if (_isAdmin)
    {
        <FluentCard Class="org-create-card">
            <FluentText Tag="TextTag.H2" Size="TextSize.Size500" Weight="TextWeight.Semibold">Create organization</FluentText>
            <label>Organization name <FluentTextInput @bind-Value="_newName" Required="true" /></label>
            <FluentCheckbox @bind-Value="_useCurrentUser" Label="Make me the initial owner" />
            @if (!_useCurrentUser)
            {
                <div class="owner-search">
                    <label>Search initial owner by username or email <FluentTextInput @bind-Value="_ownerQuery" /></label>
                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="SearchOwnersAsync">Search users</FluentButton>
                </div>
                @if (!string.IsNullOrWhiteSpace(_searchFeedback))
                {
                    <FluentMessageBar Intent="MessageBarIntent.Info">@_searchFeedback</FluentMessageBar>
                }
                <label>Initial owner user ID
                    <select @bind="_initialOwnerId">
                        <option value="">Select a user</option>
                        @foreach (var user in _ownerResults)
                        {
                            <option value="@user.Id">@user.UserName (@user.Email)</option>
                        }
                    </select>
                </label>
            }
            else
            {
                <p class="sp-muted">Initial owner user ID: your authenticated account</p>
            }
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="CreateAsync">Create organization</FluentButton>
        </FluentCard>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppErrorState Title="Unable to load organization management" Message="@_error" OnRetry="ReloadAsync" />
    }
    else if (_selected is null && OrganizationId != 0)
    {
        <AppEmptyState Title="Organization unavailable" Message="This organization is unavailable or you no longer have membership." Icon="@(new Icons.Regular.Size24.Organization())" />
    }
    else if (_selected is not null)
    {
        <OrganizationDetails Organization="_selected" OrganizationChanged="UpdateSelected" />
        <OrganizationMembers OrganizationId="_selected.OrganizationId" CanManage="@(_selected.Role == OrganizationRole.Owner)" />
        <FluentMessageBar Intent="MessageBarIntent.Info">Members need explicit project grants. After backup recovery, member grants must be reviewed and reissued before work access is restored.</FluentMessageBar>
        @foreach (var project in _projects)
        {
            <FluentCard Class="project-access-card">
                <FluentText Tag="TextTag.H2" Size="TextSize.Size500" Weight="TextWeight.Semibold">@project.ProjectName access</FluentText>
                <ProjectAccessEditor ProjectId="project.ProjectId" CanManage="@(_selected.Role == OrganizationRole.Owner)" />
            </FluentCard>
        }
        <OrganizationDangerZone Organization="_selected" Changed="ReloadAsync" />
    }

    @if (_deletedOrganizations.Count > 0)
    {
        <section class="deleted-organizations" aria-labelledby="deleted-organizations-heading">
            <FluentText Id="deleted-organizations-heading" Tag="TextTag.H2" Size="TextSize.Size500" Weight="TextWeight.Semibold">Deleted organizations</FluentText>
            @foreach (var organization in _deletedOrganizations)
            {
                <FluentCard>
                    <FluentText Tag="TextTag.H3" Size="TextSize.Size400" Weight="TextWeight.Semibold">@organization.Name</FluentText>
                    <OrganizationDangerZone Organization="organization" CanPurge="_isAdmin" Changed="ReloadAsync" />
                </FluentCard>
            }
        </section>
    }
</div>

@code {
    [Parameter] public int OrganizationId { get; set; }
    private OrganizationSummaryDto? _selected;
    private List<OrganizationSummaryDto> _organizations = [];
    private Dictionary<int, OperationStatus> _operations = [];
    private List<Project> _projects = [];
    private List<OrganizationSummaryDto> _deletedOrganizations = [];
    private bool _isAdmin;
    private bool _useCurrentUser = true;
    private string _currentUserId = string.Empty;
    private string _initialOwnerId = string.Empty;
    private string _ownerQuery = string.Empty;
    private List<UserSummaryDto> _ownerResults = [];
    private string _newName = string.Empty;
    private string? _error;
    private string? _searchFeedback;
    private CancellationTokenSource? _cancellation;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _isAdmin = user.IsInRole("Admin");
        _currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value ?? string.Empty;
        await ReloadAsync();
    }

    private void OnOrganizationChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        if (_disposed) return;
        var cancellation = new CancellationTokenSource();
        var previous = _cancellation;
        _cancellation = cancellation;
        previous?.Cancel();
        previous?.Dispose();
        var token = cancellation.Token;
        try
        {
            var organizations = await GetJsonWithRetryAsync<List<OrganizationSummaryDto>>("api/organizations", token) ?? [];
            if (_disposed || cancellation != _cancellation) return;
            _organizations = organizations.Where(x => !x.IsDeleted).ToList();
            _selected = organizations.FirstOrDefault(x => x.OrganizationId == OrganizationId && !x.IsDeleted);
            _projects = _selected is null
                ? []
                : await GetJsonWithRetryAsync<List<Project>>(
                    $"api/organizations/{_selected.OrganizationId}/projects",
                    token) ?? [];
            if (_disposed || cancellation != _cancellation) return;
            if (_isAdmin && OrganizationId == 0)
            {
                var operations = new Dictionary<int, OperationStatus>();
                foreach (var organization in _organizations)
                {
                    try
                    {
                        var status = await Http.GetFromJsonAsync<OperationStatus>($"api/organizations/{organization.OrganizationId}/operations", token);
                        if (_disposed || cancellation != _cancellation) return;
                        if (status is not null) operations[organization.OrganizationId] = status;
                    }
                    catch (HttpRequestException) { }
                    catch (System.Text.Json.JsonException) { }
                }
                _operations = operations;
            }
            _deletedOrganizations = await GetJsonWithRetryAsync<List<OrganizationSummaryDto>>(
                "api/organizations/deleted",
                token) ?? [];
            if (_disposed || cancellation != _cancellation) return;
            _error = null;
        }

        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) when (!_disposed && cancellation == _cancellation)
        {
            Logger.LogError(ex, "Unable to load organization management");
            _error = "Unable to load organization management.";
            Notifications.ShowError(_error);
        }
    }

    private async Task<T?> GetJsonWithRetryAsync<T>(
        string requestUri,
        CancellationToken cancellationToken)
    {
        for (var attempt = 1; attempt <= 3; attempt++)
        {
            try
            {
                using var response = await Http.GetAsync(requestUri, cancellationToken);
                if (response.IsSuccessStatusCode)
                    return await response.Content.ReadFromJsonAsync<T>(cancellationToken);

                if (response.StatusCode is not (
                    System.Net.HttpStatusCode.RequestTimeout
                    or System.Net.HttpStatusCode.BadGateway
                    or System.Net.HttpStatusCode.ServiceUnavailable
                    or System.Net.HttpStatusCode.GatewayTimeout)
                    || attempt == 3)
                {
                    throw new HttpRequestException(
                        $"Request failed with HTTP status {(int)response.StatusCode}.",
                        null,
                        response.StatusCode);
                }
            }
            catch (HttpRequestException exception)
                when (attempt < 3
                      && exception.StatusCode is
                          System.Net.HttpStatusCode.RequestTimeout
                          or System.Net.HttpStatusCode.BadGateway
                          or System.Net.HttpStatusCode.ServiceUnavailable
                          or System.Net.HttpStatusCode.GatewayTimeout)
            {
            }

            await Task.Delay(attempt * 250, cancellationToken);
        }
        throw new HttpRequestException("Request remained unavailable after retries.");
    }

    private async Task RetryProvisioningAsync(int organizationId)
        {
            if (!_isAdmin || _disposed || !_operations.TryGetValue(organizationId, out var operation)
                || operation.State is not ("Failed" or "Provisioning")) return;
            var cancellation = _cancellation;
            if (cancellation is null) return;
            try
            {
                using var response = await Http.PostAsync($"api/organizations/{organizationId}/operations/retry", null, cancellation.Token);
                if (_disposed || cancellation != _cancellation) return;
                if (!response.IsSuccessStatusCode)
                {
                    _error = "Unable to retry organization provisioning.";
                    return;
                }
                await ReloadAsync();
            }
            catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
            catch (HttpRequestException)
            {
                if (!_disposed && cancellation == _cancellation) _error = "Unable to retry organization provisioning.";
            }
        }

    private sealed record OperationStatus(int OrganizationId, string State, string? OperationId, string? Error);

    private async Task CreateAsync()
    {
        _error = null;
        var ownerId = _useCurrentUser ? _currentUserId : _initialOwnerId.Trim();
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(ownerId))
        {
            _error = "Organization name and initial owner are required.";
            return;
        }
        try
        {
            var response = await Http.PostAsJsonAsync("api/organizations", new CreateOrganizationRequest(_newName.Trim(), ownerId));
            if (!response.IsSuccessStatusCode) { _error = "Unable to create the organization."; return; }
            _newName = string.Empty;
            Notifications.ShowSuccess("Organization created.");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to create organization");
            _error = "Unable to create the organization.";
        }
    }

    private async Task SearchOwnersAsync()
    {
        _searchFeedback = null;
        if (_ownerQuery.Trim().Length < 2)
        {
            _ownerResults = [];
            _searchFeedback = "Enter at least two characters to search.";
            return;
        }
        try
        {
            _ownerResults = await Http.GetFromJsonAsync<List<UserSummaryDto>>($"api/User/admin-search?query={Uri.EscapeDataString(_ownerQuery.Trim())}") ?? [];
            _searchFeedback = _ownerResults.Count == 0 ? "No users found." : null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to search users");
            _ownerResults = [];
            _searchFeedback = "Unable to search users.";
        }
    }

    private void UpdateSelected(OrganizationSummaryDto organization)
    {
        _selected = organization;
        OrganizationState.SetOrganization(organization);
    }

    public void Dispose()
    {
        _disposed = true;
        OrganizationState.OnChange -= OnOrganizationChanged;
        var cancellation = _cancellation;
        _cancellation = null;
        cancellation?.Cancel();
        cancellation?.Dispose();
    }
}
