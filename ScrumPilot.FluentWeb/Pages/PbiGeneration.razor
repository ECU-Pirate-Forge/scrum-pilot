@page "/pbigeneration"
@page "/pbi-generation"
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using ScrumPilot.FluentWeb.Components.Pbi
@inject HttpClient Http
@inject ProjectStateService ProjectState
@inject IAppNotificationService Notifications
@inject ILogger<PbiGeneration> Logger

<PageTitle>Generate PBIs</PageTitle>

<div class="pbi-generation-page">
    <AppPageHeader Title="Generate PBIs" Subtitle="Create draft backlog items from problem statements, themes, and milestones." />

    <section class="sp-panel pbi-generation-form" aria-labelledby="problem-statements-heading">
        <h2 id="problem-statements-heading">Problem statements</h2>
        <div class="pbi-generation-input-row">
            <label class="pbi-generation-field sp-grow">
                <span>Problem statement</span>
                <InputText class="pbi-generation-input" @bind-Value="_message" @onkeydown="HandleInputKeyDownAsync" disabled="@_isLoading" placeholder="Enter problem statement" />
            </label>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="AddProblemStatement" Disabled="@(_isLoading || string.IsNullOrWhiteSpace(_message))" IconStart="@(new Icons.Regular.Size20.Add())">Add</FluentButton>
        </div>

        <label class="pbi-generation-upload">
            <AppIcon Value="@(new Icons.Regular.Size24.ArrowUpload())" Label="" />
            <span>Import CSV (one problem statement per line, no header)</span>
            <InputFile OnChange="HandleCsvUploadAsync" accept=".csv" disabled="@_isLoading" />
        </label>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <FluentMessageBar Intent="MessageBarIntent.Error">@_errorMessage</FluentMessageBar>
        }

        @if (_problemStatements.Count > 0)
        {
            <ol class="pbi-generation-list">
                @for (var i = 0; i < _problemStatements.Count; i++)
                {
                    var index = i;
                    <li>
                        <span>@_problemStatements[index]</span>
                        <FluentButton Appearance="ButtonAppearance.Subtle" IconOnly="true" Title="Remove problem statement" OnClick="@(() => RemoveProblemStatement(index))" Disabled="_isLoading">
                            <AppIcon Value="@(new Icons.Regular.Size20.Delete())" Label="Remove" />
                        </FluentButton>
                    </li>
                }
            </ol>

            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="GenerateAsync" Loading="_isLoading" Disabled="_isLoading">
                Generate PBIs (@_problemStatements.Count)
            </FluentButton>
        }
    </section>

    @if (_isLoading)
    {
        <AppLoadingState Message="Writing your PBIs..." />
    }

    <GeneratedPbiDialog PBIs="_generatedPbis"
                        ProjectId="ProjectState.SelectedProjectId"
                        @bind-Open="_generatedDialogOpen" />
</div>

@code {
    private string _message = string.Empty;
    private bool _isLoading;
    private readonly List<string> _problemStatements = [];
    private List<ProductBacklogItem> _generatedPbis = [];
    private bool _generatedDialogOpen;
    private string _errorMessage = string.Empty;

    private void AddProblemStatement()
    {
        _errorMessage = string.Empty;
        var statement = _message.Trim();
        if (string.IsNullOrWhiteSpace(statement))
        {
            _errorMessage = "Please enter a problem statement.";
            Notifications.ShowWarning(_errorMessage);
            return;
        }

        if (_problemStatements.Contains(statement, StringComparer.OrdinalIgnoreCase))
        {
            _errorMessage = "That problem statement has already been added.";
            Notifications.ShowWarning(_errorMessage);
            return;
        }

        _problemStatements.Add(statement);
        _message = string.Empty;
    }

    private void RemoveProblemStatement(int index)
    {
        if (index >= 0 && index < _problemStatements.Count)
        {
            _problemStatements.RemoveAt(index);
        }
    }

    private async Task HandleInputKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddProblemStatement();
            await Task.CompletedTask;
        }
    }

    private async Task HandleCsvUploadAsync(InputFileChangeEventArgs e)
    {
        _errorMessage = string.Empty;
        var file = e.File;
        if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
        {
            _errorMessage = "Please upload a .csv file.";
            Notifications.ShowWarning(_errorMessage);
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1_048_576);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();
            var parsed = ParseCsvStatements(content);
            if (parsed.Count == 0)
            {
                _errorMessage = "CSV did not contain any problem statements.";
                Notifications.ShowWarning(_errorMessage);
                return;
            }

            var added = 0;
            foreach (var statement in parsed)
            {
                if (_problemStatements.Contains(statement, StringComparer.OrdinalIgnoreCase))
                {
                    continue;
                }
                _problemStatements.Add(statement);
                added++;
            }

            if (added == 0)
            {
                _errorMessage = "All CSV problem statements were duplicates.";
                Notifications.ShowWarning(_errorMessage);
            }
            else
            {
                Notifications.ShowSuccess($"{added} problem statement{(added == 1 ? string.Empty : "s")} imported.");
            }
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "Failed to read PBI CSV import");
            _errorMessage = $"Failed to read CSV: {ex.Message}";
            Notifications.ShowError(_errorMessage);
        }
    }

    private static List<string> ParseCsvStatements(string content)
    {
        var statements = new List<string>();
        foreach (var rawLine in content.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries))
        {
            var line = rawLine.Trim().Trim('"');
            if (!string.IsNullOrWhiteSpace(line))
            {
                statements.Add(line);
            }
        }
        return statements;
    }

    private async Task GenerateAsync()
    {
        if (_problemStatements.Count == 0)
        {
            _errorMessage = "Add at least one problem statement before generating PBIs.";
            Notifications.ShowWarning(_errorMessage);
            return;
        }

        _isLoading = true;
        _errorMessage = string.Empty;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromMinutes(5));
            var json = JsonSerializer.Serialize(_problemStatements);
            using var content = new StringContent(json, Encoding.UTF8, "application/json");
            var response = await Http.PostAsync("api/pbi/generateAiPbis", content, timeout.Token);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync(timeout.Token);
                _errorMessage = $"Failed to generate PBIs: {error}";
                Notifications.ShowError(_errorMessage);
                return;
            }

            var responseBody = await response.Content.ReadAsStringAsync(timeout.Token);
            var generated = JsonSerializer.Deserialize<List<ProductBacklogItem>>(responseBody, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (generated is null || generated.Count == 0)
            {
                _errorMessage = "Generation completed but the response did not contain valid PBIs.";
                Notifications.ShowError(_errorMessage);
                return;
            }

            _generatedPbis = generated;
            _generatedDialogOpen = true;
            _problemStatements.Clear();
            _message = string.Empty;
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogWarning(ex, "PBI generation timed out");
            _errorMessage = "Request timed out. Please try again.";
            Notifications.ShowError(_errorMessage);
        }
        catch (JsonException ex)
        {
            Logger.LogWarning(ex, "Failed to parse generated PBI response");
            _errorMessage = "Failed to parse response from server.";
            Notifications.ShowError(_errorMessage);
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Network error generating PBIs");
            _errorMessage = $"Network error: {ex.Message}";
            Notifications.ShowError(_errorMessage);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
