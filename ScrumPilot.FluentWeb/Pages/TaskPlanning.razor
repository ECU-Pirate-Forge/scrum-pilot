@page "/task-planning"
@page "/organizations/{OrganizationId:int}/task-planning"
@inherits PlanningComponentBase
@using System.Text.Json
@using System.Text.Json.Serialization
@using ScrumPilot.FluentWeb.Components.ProjectManagement
@using ScrumPilot.FluentWeb.Components.Pbi
@using ScrumPilot.Shared.Models
@inject IJSRuntime JS
@inject Microsoft.Extensions.Options.IOptions<FeatureOptions> Features
@inject HttpClient FeatureHttp
@inject OrganizationStateService OrganizationState
@inject ILogger<TaskPlanning> Logger

<PageTitle>Task Planning</PageTitle>
<AppPageHeader Title="Task Planning" Subtitle="Create and regenerate tasks from existing stories and bugs." />
<div class="task-planning-page">
@if (!ProjectId.HasValue)
{
    <p>Select a project before planning tasks.</p>
}
else
{
    @if (_error.Length > 0) { <p role="alert">@_error</p> }
    @if (_notice.Length > 0) { <p role="status">@_notice</p> }
    @* <FluentButton OnClick="LoadAsync">Refresh work</FluentButton> *@
    <section class="task-planning-workspace" aria-label="Create tasks from existing work">
        <div class="sp-panel task-planning-source-column">
            <div class="task-planning-heading">
                <span class="task-planning-step">1</span>
                <div>
                    <h2>Choose work</h2>
                    <p>Create and manage tasks from one committed story or bug.</p>
                </div>
            </div>
            <label>Source story or bug
                <select @bind="_sourcePbiId">
                    <option value="0">Select a committed story or bug</option>
                    @foreach (var source in EligibleSources)
                    {
                        <option value="@source.PbiId">#@source.PbiId @source.Type: @source.Title</option>
                    }
                </select>
            </label>
        @if (SelectedSource is not null)
        {
            <section aria-label="Add a task manually">
                <h3>Add a task manually</h3>
                <label>Task title <input @bind="_manualTitle" /></label>
                <label>Task description <textarea rows="4" @bind="_manualDescription"></textarea></label>
                <FluentButton OnClick="CreateManualAsync" Disabled="_busy">Add draft task</FluentButton>
            </section>
        }
        </div>
        @if (SelectedSource is { } sourcePbi)
        {
        <aside class="sp-panel task-planning-sidebar">
            <div class="task-planning-heading">
                <span class="task-planning-step">2</span>
                <div>
                    <h2>Plan and review</h2>
                    <p>@(_creationPreview is null ? "Generate a preview before saving draft tasks." : "Review and edit proposals before saving.")</p>
                </div>
            </div>
            <section aria-label="Generate tasks with AI">
                <h3>Generate tasks with AI</h3>
                <p>Generation uses this work item's content and current project guidelines; no GitHub repository or file snapshot is needed.</p>
                @if (HasGeneratedTasks(sourcePbi.PbiId))
                {
                    <FluentButton OnClick="() => GenerateTasksAsync(true)" Disabled="_busy" Loading="_busy">Regenerate and replace generated tasks</FluentButton>
                }
                else
                {
                    <FluentButton OnClick="() => GenerateTasksAsync(false)" Disabled="_busy" Loading="_busy">Generate task preview</FluentButton>
                }
                @if (_creationPreview is not null)
                {
                    <h4>Review and edit proposals</h4>
                    <p>Edit proposal JSON before accepting. Regeneration removes only previously generated child tasks; manually added tasks are preserved.</p>
                    @foreach (var proposal in _creationProposals)
                    {
                        <label><input type="checkbox" @bind="proposal.Selected" /> Accept @proposal.Key</label>
                        <textarea rows="16" @bind="proposal.Json" spellcheck="false" aria-label="@($"Proposal {proposal.Key}")"></textarea>
                        <FluentButton OnClick="@(() => CopyAsync(proposal.Json))">Copy @proposal.Key</FluentButton>
                    }
                    <label><input type="checkbox" @bind="_asDraft" /> Save accepted work as drafts</label>
                    <FluentButton OnClick="AcceptCreatedTasksAsync" Disabled="_busy">Save selected task proposals</FluentButton>
                }
            </section>
            <section aria-label="Tasks associated with selected work item">
                <h3>Child tasks</h3>
                @foreach (var task in ChildTasks(sourcePbi.PbiId))
                {
                    <details>
                        <summary>#@task.PbiId @task.Title (@(task.IsDraft ? "Draft" : task.Status.ToString()))</summary>
                        @if (task.Origin == PbiOrigin.AiGenerated)
                        {
                            <label>Copyable implementation spec
                                <textarea rows="16" readonly>@task.Description</textarea>
                            </label>
                            <FluentButton OnClick="@(() => CopyAsync(task.Description))">Copy task @task.PbiId</FluentButton>
                        }
                        else
                        {
                            <p>@task.Description</p>
                        }
                        <FluentButton OnClick="() => DeleteTaskAsync(task)" Disabled="_busy">Remove task</FluentButton>
                    </details>
                }
                @if (!ChildTasks(sourcePbi.PbiId).Any()) { <p>No child tasks yet.</p> }
            </section>
        </aside>
        }
    </section>

    @if (_githubEnabled)
    {
        <div class="task-planning-github-grid">
        <section class="sp-panel" aria-label="Repository-backed task implementation planning">
            <ProjectRepositorySettings @key="(Scope.OrganizationId, ProjectId.Value)" CapturedWork="Scope" ProjectId="ProjectId.Value" IsOwner="IsOwner" />
            <h2>Repository-backed task specification and PR enforcement</h2>
            <label>Task
                <select @bind="_taskId">
                    <option value="0">Select a task</option>
                    @foreach (var task in _items.Where(item => item.Type == PbiType.Task))
                    { <option value="@task.PbiId">#@task.PbiId @task.Title</option> }
                </select>
            </label>
            @if (_taskId > 0)
            { <TaskSpecificationEditor @key="(Scope.OrganizationId, ProjectId.Value, _taskId)" CapturedWork="Scope" ProjectId="ProjectId.Value" TaskId="_taskId" IsOwner="IsOwner" Snapshots="_snapshots" /> }
        </section>
        <section class="sp-panel" aria-label="Legacy repository-backed task generation">
            <h2>Generate tasks with repository context</h2>
            @foreach (var story in _items.Where(item => item.Type == PbiType.Story && !item.IsDraft))
            {
                <label><input type="checkbox" checked="@_selectedStories.Contains(story.PbiId)" @onchange="args => Select(story.PbiId, args.Value is true)" />
                    #@story.PbiId @story.Title
                </label>
            }
            <label>Branch for a new immutable snapshot <input @bind="_branch" /></label>
            <FluentButton OnClick="CreateSnapshotAsync" Disabled="_busy">Verify branch snapshot</FluentButton>
            <label>Repository snapshot
                <select @bind="_snapshotId">
                    <option value="0">Select a verified snapshot</option>
                    @foreach (var snapshot in _snapshots) { <option value="@snapshot.RepositorySnapshotId">@snapshot.CommitSha</option> }
                </select>
            </label>
            <label>Relevant source paths (one per line, exact repository-relative paths)
                <textarea rows="5" @bind="_sourcePaths"></textarea>
            </label>
            <FluentButton OnClick="GenerateAsync" Disabled="_busy" Loading="_busy">Generate repository-bound task preview</FluentButton>
            @if (_githubPreview is not null)
            {
                <h3>Review repository-bound task proposals</h3>
                @foreach (var proposal in _githubProposals)
                {
                    <label><input type="checkbox" @bind="proposal.Selected" /> Accept @proposal.Key</label>
                    <textarea rows="20" @bind="proposal.Json" spellcheck="false" aria-label="@($"Proposal {proposal.Key}")"></textarea>
                    <FluentButton OnClick="@(() => CopyAsync(proposal.Json))">Copy @proposal.Key</FluentButton>
                }
                <label><input type="checkbox" @bind="_asDraft" /> Save as draft work</label>
                <FluentButton OnClick="AcceptAsync" Disabled="_busy">Save selected repository-bound task proposals</FluentButton>
            }
        </section>
        </div>
    }
}
</div>

@code {
    private static readonly JsonSerializerOptions EditorJson = new(JsonSerializerDefaults.Web)
        { WriteIndented = true, Converters = { new JsonStringEnumConverter() } };
    private int? ProjectId => Scope.ProjectId;
    private bool IsOwner => OrganizationState.SelectedOrganization?.OrganizationId == Scope.OrganizationId
        && OrganizationState.SelectedOrganization.Role == OrganizationRole.Owner;
    private ProductBacklogItem[] _items = [];
    private RepositorySnapshot[] _snapshots = [];
    private int _sourcePbiId, _taskId, _snapshotId;
    private string _manualTitle = "", _manualDescription = "";
    private readonly HashSet<int> _selectedStories = [];
    private readonly List<ProposalEditor> _githubProposals = [];
    private readonly List<TaskCreationProposalEditor> _creationProposals = [];
    private TaskGenerationPreviewDto? _githubPreview;
    private TaskCreationPreviewDto? _creationPreview;
    private string _branch = "main", _sourcePaths = "", _error = "", _notice = "";
    private bool _busy, _asDraft = true, _githubEnabled;
    private long _loadGeneration;
    private IEnumerable<ProductBacklogItem> EligibleSources => _items.Where(item =>
        (item.Type is PbiType.Story or PbiType.Bug) && !item.IsDraft && item.Status != PbiStatus.Done);
    private ProductBacklogItem? SelectedSource => _items.SingleOrDefault(item =>
        item.PbiId == _sourcePbiId && (item.Type is PbiType.Story or PbiType.Bug)
        && !item.IsDraft && item.Status != PbiStatus.Done);

    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!Scope.IsCurrent || !ProjectId.HasValue) return;
        var generation = ++_loadGeneration;
        var project = ProjectId;
        try
        {
            FeatureSettings? features;
            try
            {
                features = await FeatureHttp.GetFromJsonAsync<FeatureSettings>("api/features", Scope.Cancellation);
            }
            catch (HttpRequestException ex)
            {
                Logger.LogWarning(ex, "Unable to load API feature settings; using the client fallback");
                features = null;
            }

            var items = await Http.GetFromJsonAsync<ProductBacklogItem[]>($"api/Pbi/getAllPbis?projectId={project}") ?? [];
            var githubEnabled = features?.GitHubIntegrationEnabled
                ?? Features.Value.GitHubIntegration;
            var snapshots = githubEnabled
                ? await Http.GetFromJsonAsync<RepositorySnapshot[]>($"api/projects/{project}/repository/snapshots") ?? []
                : [];
            if (Scope.IsCurrent && generation == _loadGeneration)
            {
                _githubEnabled = githubEnabled;
                _items = items;
                _snapshots = snapshots;
                if (!EligibleSources.Any(item => item.PbiId == _sourcePbiId)) _sourcePbiId = 0;
            }
        }
        catch (OperationCanceledException) when (!Scope.IsCurrent) { }
        catch (HttpRequestException ex)
        {
            if (!Scope.IsCurrent || generation != _loadGeneration) return;
            Logger.LogWarning(ex, "Task planning load failed");
            _error = "Unable to load project work or feature settings.";
        }
    }

    private bool HasGeneratedTasks(int parentId) => _items.Any(item => item.Type == PbiType.Task
        && item.Origin == PbiOrigin.AiGenerated && item.ParentStoryId == parentId);

    private IEnumerable<ProductBacklogItem> ChildTasks(int parentId) => _items.Where(item =>
        item.Type == PbiType.Task && item.ParentStoryId == parentId).OrderBy(item => item.PbiId);

    private void Select(int id, bool selected)
    {
        if (selected) _selectedStories.Add(id);
        else _selectedStories.Remove(id);
    }

    private async Task CreateManualAsync() => await ExecuteAsync(async () =>
    {
        using var response = await Http.PostAsJsonAsync(
            $"api/projects/{ProjectId}/task-creation",
            new CreateManualChildTaskRequest(_sourcePbiId, _manualTitle, _manualDescription));
        if (!response.IsSuccessStatusCode) { _error = await Http.ReadAsStringAsync(response.Content); return; }
        _manualTitle = "";
        _manualDescription = "";
        await LoadAsync();
    });

    private async Task GenerateTasksAsync(bool replaceGeneratedTasks) => await ExecuteAsync(async () =>
    {
        using var response = await Http.PostAsJsonAsync(
            $"api/projects/{ProjectId}/task-creation/preview",
            new GenerateTaskCreationPreviewRequest([_sourcePbiId], Guid.NewGuid().ToString("N"), replaceGeneratedTasks));
        if (!response.IsSuccessStatusCode) { _error = await Http.ReadAsStringAsync(response.Content); return; }
        _creationPreview = await Http.ReadFromJsonAsync<TaskCreationPreviewDto>(response.Content);
        _creationProposals.Clear();
        foreach (var task in _creationPreview?.Tasks ?? [])
            _creationProposals.Add(new(task.Key, JsonSerializer.Serialize(task, EditorJson)));
    });

    private async Task AcceptCreatedTasksAsync() => await ExecuteAsync(async () =>
    {
        if (_creationPreview is null) return;
        var tasks = _creationProposals.Where(proposal => proposal.Selected)
            .Select(proposal => JsonSerializer.Deserialize<TaskCreationProposalDto>(proposal.Json, EditorJson)
                ?? throw new JsonException()).ToArray();
        using var response = await Http.PostAsJsonAsync(
            $"api/projects/{ProjectId}/task-creation/accept",
            new AcceptTaskCreationProposalsRequest(_creationPreview.GenerationRunId, tasks, _asDraft));
        if (!response.IsSuccessStatusCode) { _error = await Http.ReadAsStringAsync(response.Content); return; }
        _creationPreview = null;
        _creationProposals.Clear();
        _asDraft = true;
        await LoadAsync();
    });

    private async Task DeleteTaskAsync(ProductBacklogItem task) => await ExecuteAsync(async () =>
    {
        if (!await JS.InvokeAsync<bool>("confirm",
                $"Permanently remove task #{task.PbiId} and its task-owned planning records?"))
            return;
        using var response = await Http.DeleteAsync(
            $"api/projects/{ProjectId}/task-creation/{task.PbiId}");
        if (!response.IsSuccessStatusCode) { _error = await Http.ReadAsStringAsync(response.Content); return; }
        await LoadAsync();
    });

    private async Task CreateSnapshotAsync() => await ExecuteAsync(async () =>
    {
        var project = ProjectId;
        using var response = await Http.PostAsJsonAsync($"api/projects/{project}/repository/snapshots", new CreateRepositorySnapshotRequest(_branch));
        if (!response.IsSuccessStatusCode) { _error = await Http.ReadAsStringAsync(response.Content); return; }
        var snapshot = await Http.ReadFromJsonAsync<RepositorySnapshot>(response.Content);
        await LoadAsync();
        _snapshotId = snapshot?.RepositorySnapshotId ?? 0;
    });

    private async Task GenerateAsync() => await ExecuteAsync(async () =>
    {
        var project = ProjectId;
        using var response = await Http.PostAsJsonAsync($"api/projects/{project}/task-generation/preview",
            new GenerateTaskPreviewRequest(_selectedStories.Order().ToArray(), _snapshotId,
                _sourcePaths.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries), Guid.NewGuid().ToString("N")));
        if (!response.IsSuccessStatusCode) { _error = await Http.ReadAsStringAsync(response.Content); return; }
        _githubPreview = await Http.ReadFromJsonAsync<TaskGenerationPreviewDto>(response.Content);
        _githubProposals.Clear();
        foreach (var task in _githubPreview?.Tasks ?? [])
            _githubProposals.Add(new(task.Key, JsonSerializer.Serialize(task, EditorJson)));
    });

    private async Task AcceptAsync() => await ExecuteAsync(async () =>
    {
        if (_githubPreview is null) return;
        var project = ProjectId;
        var tasks = _githubProposals.Where(proposal => proposal.Selected)
            .Select(proposal => JsonSerializer.Deserialize<TaskProposalDto>(proposal.Json, EditorJson)
                ?? throw new JsonException()).ToArray();
        using var response = await Http.PostAsJsonAsync($"api/projects/{project}/task-generation/accept",
            new AcceptTaskProposalsRequest(_githubPreview.GenerationRunId, tasks, _asDraft));
        if (!response.IsSuccessStatusCode) { _error = await Http.ReadAsStringAsync(response.Content); return; }
        _githubPreview = null;
        _githubProposals.Clear();
        await LoadAsync();
    });
    private async Task CopyAsync(string text)
    {
        if (!Scope.IsCurrent) return;
        _error = "";
        _notice = "";
        try
        {
            var copied = await JS.InvokeAsync<bool>("mermaidHelper.copyText", text);
            if (!Scope.IsCurrent) return;
            if (copied) _notice = "Copied to clipboard.";
            else _error = "Could not copy to the clipboard.";
        }
        catch (JSException ex)
        {
            if (!Scope.IsCurrent) return;
            Logger.LogWarning(ex, "Task proposal clipboard copy failed");
            _error = "Could not copy to the clipboard.";
        }
    }
    private async Task ExecuteAsync(Func<Task> action)
    {
        if (!Scope.IsCurrent || _busy || !ProjectId.HasValue) return;
        _busy = true;
        _error = "";
        try { await action(); }
        catch (OperationCanceledException) when (!Scope.IsCurrent) { }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException or JSException)
        {
            if (!Scope.IsCurrent) return;
            Logger.LogWarning(ex, "Task planning operation failed");
            _error = ex is JsonException ? "A proposal contains invalid JSON."
                : "Planning failed or timed out. Check configuration and retry.";
        }
        finally { _busy = false; }
    }

    private sealed class ProposalEditor(string key, string json)
    {
        public string Key { get; } = key;
        public string Json { get; set; } = json;
        public bool Selected { get; set; } = true;
    }

    private sealed class TaskCreationProposalEditor(string key, string json)
    {
        public string Key { get; } = key;
        public string Json { get; set; } = json;
        public bool Selected { get; set; } = true;
    }

    private sealed record FeatureSettings(bool GitHubIntegrationEnabled);
}
