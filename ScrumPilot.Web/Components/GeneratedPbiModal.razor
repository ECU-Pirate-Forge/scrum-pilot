@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            @if (_items.Count > 0)
            {
                var currentItem = _items[_currentPbiIndex];

                <MudText Typo="Typo.h5" Align="Align.Center">Generated PBIs</MudText>

                <div class="generated-pbi-status">
                    <MudChip T="string"
                             Color="@GetStateColor(currentItem.State)"
                             Variant="Variant.Filled">
                        @GetStateLabel(currentItem.State)
                    </MudChip>
                </div>

                <PbiCard PbiModel="@currentItem.Pbi"
                         ProjectId="@ProjectId"
                         PersistOnSave="false"
                         ReadOnly="@(currentItem.State != GeneratedPbiSaveState.Pending)" />

                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Class="generated-pbi-navigation">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Primary"
                                   OnClick="ShowPreviousPbi"
                                   Disabled="@(_currentPbiIndex == 0 || _isCommitting)"
                                   AriaLabel="Show previous PBI" />

                    <MudText Typo="Typo.subtitle1" Class="generated-pbi-position">
                        @($"{_currentPbiIndex + 1} of {_items.Count}")
                    </MudText>

                    <MudIconButton Icon="@Icons.Material.Filled.ArrowForward"
                                   Color="Color.Primary"
                                   OnClick="ShowNextPbi"
                                   Disabled="@(_currentPbiIndex >= _items.Count - 1 || _isCommitting)"
                                   AriaLabel="Show next PBI" />
                </MudStack>

                @if (currentItem.State == GeneratedPbiSaveState.Pending)
                {
                    <div class="generated-pbi-actions">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Drafts"
                                   OnClick="SaveCurrentAsDraft"
                                   Disabled="@_isCommitting">
                            Save as Draft
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.PlaylistAdd"
                                   OnClick="SaveCurrentToBacklog"
                                   Disabled="@_isCommitting">
                            Add to Backlog
                        </MudButton>
                    </div>
                }

                @if (PendingCount > 0)
                {
                    <MudDivider />
                    <div class="generated-pbi-actions">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Drafts"
                                   OnClick="SaveRemainingAsDrafts"
                                   Disabled="@_isCommitting">
                            @($"Save Remaining as Drafts ({PendingCount})")
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.PlaylistAdd"
                                   OnClick="SaveRemainingToBacklog"
                                   Disabled="@_isCommitting">
                            @($"Add Remaining to Backlog ({PendingCount})")
                        </MudButton>
                    </div>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                        All generated PBIs have been saved.
                    </MudAlert>
                }
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    No generated PBIs were returned.
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
</MudDialog>

@code {
    [Parameter]
    public List<ProductBacklogItem> PBIs { get; set; } = new();

    [Parameter]
    public int? ProjectId { get; set; }

    private readonly List<GeneratedPbiReviewItem> _items = new();
    private List<ProductBacklogItem>? _initializedPbis;
    private int _currentPbiIndex;
    private bool _isCommitting;
    private int PendingCount => _items.Count(item => item.State == GeneratedPbiSaveState.Pending);

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_initializedPbis, PBIs))
        {
            return;
        }

        _initializedPbis = PBIs;
        _items.Clear();
        _items.AddRange(PBIs.Select(pbi => new GeneratedPbiReviewItem(pbi)));
        _currentPbiIndex = 0;
    }

    private Task SaveCurrentAsDraft() =>
        SaveItems([_items[_currentPbiIndex]], true);

    private Task SaveCurrentToBacklog() =>
        SaveItems([_items[_currentPbiIndex]], false);

    private Task SaveRemainingAsDrafts() =>
        SaveItems(GetPendingItems(), true);

    private Task SaveRemainingToBacklog() =>
        SaveItems(GetPendingItems(), false);

    private List<GeneratedPbiReviewItem> GetPendingItems() =>
        _items.Where(item => item.State == GeneratedPbiSaveState.Pending).ToList();

    private async Task SaveItems(List<GeneratedPbiReviewItem> items, bool asDraft)
    {
        if (_isCommitting || items.Count == 0)
        {
            return;
        }

        _isCommitting = true;
        try
        {
            if (!ProjectId.HasValue)
            {
                Snackbar.Add("Select a project before saving PBIs.", Severity.Error);
                return;
            }

            foreach (var item in items)
            {
                if (ProjectId.HasValue)
                {
                    item.Pbi.ProjectId = ProjectId.Value;
                }
            }

            var endpoint = (asDraft ? "api/Pbi/createDraftPbis" : "api/Pbi/createStories")
                + $"?projectId={ProjectId.Value}";
            var response = await Http.PostAsJsonAsync(endpoint, items.Select(item => item.Pbi).ToList());

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to save PBIs: {error}", Severity.Error);
                return;
            }

            var savedState = asDraft
                ? GeneratedPbiSaveState.SavedAsDraft
                : GeneratedPbiSaveState.AddedToBacklog;
            foreach (var item in items)
            {
                item.State = savedState;
            }

            var destination = asDraft ? "as drafts" : "to the backlog";
            Snackbar.Add(
                $"{items.Count} PBI{(items.Count == 1 ? "" : "s")} saved {destination}.",
                Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Network error while saving PBIs: {ex.Message}", Severity.Error);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("Saving PBIs timed out. Please try again.", Severity.Error);
        }
        finally
        {
            _isCommitting = false;
        }
    }

    private void ShowPreviousPbi()
    {
        if (_currentPbiIndex > 0)
        {
            _currentPbiIndex--;
        }
    }

    private void ShowNextPbi()
    {
        if (_currentPbiIndex < _items.Count - 1)
        {
            _currentPbiIndex++;
        }
    }

    private static Color GetStateColor(GeneratedPbiSaveState state) => state switch
    {
        GeneratedPbiSaveState.SavedAsDraft => Color.Warning,
        GeneratedPbiSaveState.AddedToBacklog => Color.Success,
        _ => Color.Info
    };

    private static string GetStateLabel(GeneratedPbiSaveState state) => state switch
    {
        GeneratedPbiSaveState.SavedAsDraft => "Saved as Draft",
        GeneratedPbiSaveState.AddedToBacklog => "Added to Backlog",
        _ => "Pending Review"
    };

    private sealed class GeneratedPbiReviewItem(ProductBacklogItem pbi)
    {
        public ProductBacklogItem Pbi { get; } = pbi;
        public GeneratedPbiSaveState State { get; set; }
    }

    private enum GeneratedPbiSaveState
    {
        Pending,
        SavedAsDraft,
        AddedToBacklog
    }
}
