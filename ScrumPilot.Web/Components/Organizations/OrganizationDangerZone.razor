@inject HttpClient Http

<MudPaper Class="pa-4 mb-4" Style="border:1px solid var(--mud-palette-error)">
    <MudText Typo="Typo.h6" Color="Color.Error">Danger zone</MudText>
    <MudCheckBox @bind-Value="_confirmLeave" Label="Confirm leaving this organization" />
    <MudButton data-action="leave" Color="Color.Error" Disabled="@(!_confirmLeave)" OnClick="LeaveAsync">Leave organization</MudButton>
    @if (Organization.Role == OrganizationRole.Owner && !Organization.IsDeleted)
    {
        <MudCheckBox @bind-Value="_confirmDelete" Label="Confirm deleting this organization" />
        <MudButton data-action="delete" Color="Color.Error" Disabled="@(!_confirmDelete)" OnClick="DeleteAsync">Delete organization</MudButton>
    }
    @if (Organization.IsDeleted)
    {
        <MudButton data-action="restore" OnClick="RestoreAsync">Restore organization</MudButton>
    }
    @if (!string.IsNullOrWhiteSpace(_error)) { <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert> }
</MudPaper>

@code {
    [Parameter, EditorRequired] public OrganizationSummaryDto Organization { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }
    private bool _confirmLeave;
    private bool _confirmDelete;
    private string? _error;

    private Task LeaveAsync() => MutateAsync(
        () => Http.PostAsync($"api/organizations/{Organization.OrganizationId}/leave", null),
        "Unable to leave the organization.");
    private Task DeleteAsync() => MutateAsync(
        () => Http.DeleteAsync($"api/organizations/{Organization.OrganizationId}"),
        "Unable to delete the organization.");
    private Task RestoreAsync() => MutateAsync(
        () => Http.PostAsync($"api/organizations/{Organization.OrganizationId}/restore", null),
        "Unable to restore the organization.");

    private async Task MutateAsync(Func<Task<HttpResponseMessage>> action, string fallback)
    {
        var response = await action();
        if (!response.IsSuccessStatusCode)
        {
            try { _error = (await response.Content.ReadFromJsonAsync<ProblemDetails>())?.Detail ?? fallback; }
            catch { _error = fallback; }
            return;
        }
        await Changed.InvokeAsync();
    }
    private sealed class ProblemDetails { public string? Detail { get; set; } }
}
