@using ScrumPilot.Web.Services
@using ScrumPilot.Shared.Models
@using System.Net.Http.Json
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject HttpClient Http
@inject OrganizationStateService OrganizationState
@inject ProjectStateService ProjectState
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inherits LayoutComponentBase
@implements IDisposable
@using MudBlazor

<MudThemeProvider @ref="@_mudThemeProvider" Theme="currentTheme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Fixed="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleNavMenu"
                       Title="Toggle navigation menu" />
        <a href="" class="appbar-logo-link">
            <img src="/images/logo.png" alt="ScrumPilot" class="main-logo" />
        </a>
        <MudSpacer />
        @if (_organizations.Any())
        {
            <MudMenu Dense="true" ActivationEvent="MouseEvent.LeftClick" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                <ActivatorContent>
                    <MudButton Color="Color.Inherit"
                               EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                               StartIcon="@Icons.Material.Filled.Business"
                               Style="text-transform: none; font-size: 1rem; font-weight: 600;">
                        @(OrganizationState.SelectedOrganization?.Name ?? "Select Organization")
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var organization in _organizations)
                    {
                        var item = organization;
                        <MudMenuItem OnClick="@(() => SelectOrganizationAsync(item))">
                            @item.Name
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }
        @if (_appBarProjects.Any())
        {
            <MudMenu Dense="true" ActivationEvent="MouseEvent.LeftClick" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                <ActivatorContent>
                    <MudButton Color="Color.Inherit"
                               EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                               StartIcon="@Icons.Material.Filled.Folder"
                               Style="text-transform: none; font-size: 1rem; font-weight: 600; border: 2px solid rgba(255,255,255,0.55); border-radius: 8px; padding: 4px 14px; letter-spacing: 0.01em;">
                        @(ProjectState.SelectedProject?.ProjectName ?? "Select Project")
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var project in _appBarProjects)
                    {
                        var p = project;
                        var isActive = ProjectState.SelectedProjectId == p.ProjectId;
                        <MudMenuItem OnClick="@(() => SetGlobalProject(p))"
                                     Style="@(isActive ? "font-weight: 600;" : "")">
                            @p.ProjectName
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="@ToggleDarkMode"
                       Title="Toggle dark mode" />
        <MudIconButton Icon="@Icons.Material.Filled.Person"
                       Color="Color.Inherit"
                       Href="/user-settings"
                       Title="User settings" />
        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                       Color="Color.Inherit"
                       OnClick="@HandleLogout"
                       Title="Sign out" />
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Variant="DrawerVariant.Mini"
               Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <div class="content px-4">
            <CascadingValue Value="_isDarkMode" Name="IsDarkMode">
                @Body
            </CascadingValue>
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private bool _userPreferenceLoaded = false;
    private MudThemeProvider? _mudThemeProvider;
    private List<OrganizationSummaryDto> _organizations = [];
    private List<Project> _appBarProjects = new();
    private UserSettingsDto? _settings;
    private int _loadGeneration;
    private readonly object _selectionPersistenceLock = new();
    private Selection? _desiredSelection;
    private Selection? _persistedSelection;
    private Task _selectionWriterTask = Task.CompletedTask;
    private bool _selectionWriterRunning;
    private int _persistenceGeneration;
    private bool _disposed;

    MudTheme currentTheme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1b6ec2",
            AppbarBackground = "#1b6ec2",
            Surface = "#ffffff",
            Background = "#f5f7fa",
            TextPrimary = "#212529",
            TextSecondary = "#64748b",
            Divider = "rgba(0,0,0,0.12)",
            LinesDefault = "rgba(0,0,0,0.08)",
            TableLines = "rgba(0,0,0,0.12)",
            TableStriped = "rgba(0,0,0,0.03)",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#1b6ec2",
            Secondary = "#f48fb1",
            AppbarBackground = "#1a1a1a",
            Surface = "#161b22",
            Background = "#0d1117",
            TextPrimary = "#e6edf3",
            TextSecondary = "#8b949e",
            TextDisabled = "#484f58",
            ActionDefault = "#e6edf3",
            ActionDisabled = "#484f58",
            Divider = "#21262d",
            DividerLight = "#21262d",
            TableLines = "#21262d",
            LinesDefault = "#21262d",
            LinesInputs = "#30363d",
            TableStriped = "#1c2128",
            HoverOpacity = 0.07,
            GrayDefault = "#30363d",
            GrayLight = "#484f58",
            GrayLighter = "#6e7681",
            GrayDark = "#21262d",
            GrayDarker = "#161b22"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        ProjectState.OnProjectListChanged += OnProjectListChanged;
        var authenticationState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity?.IsAuthenticated == true)
            await LoadSessionAsync();
        else
            ClearSession();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _mudThemeProvider is not null && !_userPreferenceLoaded)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            var state = await task;
            if (state.User.Identity?.IsAuthenticated == true)
                await LoadSessionAsync();
            else
            {
                ClearSession();
                StateHasChanged();
            }
        });
    }

    private void OnProjectListChanged()
    {
        _ = InvokeAsync(async () =>
        {
            var organization = OrganizationState.SelectedOrganization;
            if (organization is not null)
            {
                var currentProjectId = ProjectState.SelectedProjectId;
                var result = await LoadProjectsAsync(
                    organization,
                    currentProjectId,
                    _settings?.DefaultProjectId,
                    persist: false);
                if (result == ProjectLoadResult.NotFound)
                    await LoadSessionAsync(new HashSet<int> { organization.OrganizationId });
            }
        });
    }

    private async Task LoadSessionAsync(IReadOnlySet<int>? rejectedOrganizationIds = null)
    {
        var generation = ++_loadGeneration;
        ClearSession(incrementGeneration: false);

        try
        {
            var organizations = await Http.GetFromJsonAsync<List<OrganizationSummaryDto>>(
                "api/organizations") ?? [];
            if (!IsCurrent(generation))
                return;

            _organizations = organizations
                .Where(o => !o.IsDeleted
                    && !(rejectedOrganizationIds?.Contains(o.OrganizationId) ?? false))
                .ToList();

            _settings = await Http.GetFromJsonAsync<UserSettingsDto>("api/user/settings");
            if (!IsCurrent(generation))
                return;

            if (_settings is not null)
            {
                _isDarkMode = _settings.UiPreference == UiPreference.Dark;
                _userPreferenceLoaded = true;
            }

            lock (_selectionPersistenceLock)
            {
                _persistedSelection = _settings?.DefaultOrganizationId is int organizationId
                    ? new Selection(organizationId, _settings.DefaultProjectId)
                    : null;
            }

            var candidates = _organizations
                .OrderByDescending(o => o.OrganizationId == _settings?.DefaultOrganizationId)
                .ToList();
            var attemptedOrganizationIds = new HashSet<int>();
            foreach (var organization in candidates)
            {
                if (!attemptedOrganizationIds.Add(organization.OrganizationId)
                    || !IsCurrent(generation))
                    continue;

                OrganizationState.SetOrganization(organization);
                var result = await LoadProjectsAsync(
                    organization,
                    _settings?.DefaultProjectId,
                    fallbackProjectId: null,
                    persist: false,
                    generation);
                if (result == ProjectLoadResult.Success || result == ProjectLoadResult.Failed)
                    return;
            }

            if ((attemptedOrganizationIds.Count > 0 || rejectedOrganizationIds?.Count > 0)
                && IsCurrent(generation))
            {
                ClearSession(incrementGeneration: false);
                Snackbar.Add("Unable to load organizations and projects.", Severity.Error);
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            if (IsCurrent(generation))
                ClearSession();
        }
        catch (Exception)
        {
            if (IsCurrent(generation))
            {
                ClearSession();
                Snackbar.Add("Unable to load organizations and projects.", Severity.Error);
            }
        }
        finally
        {
            if (IsCurrent(generation))
                StateHasChanged();
        }
    }

    private async Task SelectOrganizationAsync(OrganizationSummaryDto organization)
    {
        if (!_organizations.Any(o => o.OrganizationId == organization.OrganizationId))
            return;

        OrganizationState.SetOrganization(organization);
        _appBarProjects = [];
        ProjectState.Clear();
        StateHasChanged();
        var result = await LoadProjectsAsync(
            organization,
            _settings?.DefaultProjectId,
            fallbackProjectId: null,
            persist: true);
        if (result == ProjectLoadResult.NotFound)
            await LoadSessionAsync(new HashSet<int> { organization.OrganizationId });
    }

    private async Task<ProjectLoadResult> LoadProjectsAsync(
        OrganizationSummaryDto organization,
        int? preferredProjectId,
        int? fallbackProjectId,
        bool persist,
        int? existingGeneration = null)
    {
        var generation = existingGeneration ?? ++_loadGeneration;
        try
        {
            var projects = await Http.GetFromJsonAsync<List<Project>>(
                $"api/organizations/{organization.OrganizationId}/projects") ?? [];
            if (!IsCurrent(generation)
                || OrganizationState.SelectedOrganizationId != organization.OrganizationId)
                return ProjectLoadResult.Failed;

            _appBarProjects = projects;
            var selected = preferredProjectId is int projectId
                ? projects.FirstOrDefault(p => p.ProjectId == projectId)
                : null;
            selected ??= fallbackProjectId is int fallbackId
                ? projects.FirstOrDefault(p => p.ProjectId == fallbackId)
                : null;
            selected ??= projects.FirstOrDefault();
            ProjectState.SetProject(selected);

            if (persist)
                await PersistLatestSelectionAsync(organization.OrganizationId, selected?.ProjectId);
            return ProjectLoadResult.Success;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            if (IsCurrent(generation))
            {
                OrganizationState.Clear();
                _appBarProjects = [];
                ProjectState.Clear();
            }
            return ProjectLoadResult.NotFound;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            if (IsCurrent(generation))
                ClearSession();
            return ProjectLoadResult.Failed;
        }
        catch (Exception)
        {
            if (IsCurrent(generation))
            {
                _appBarProjects = [];
                ProjectState.Clear();
                Snackbar.Add("Unable to load projects.", Severity.Error);
            }
            return ProjectLoadResult.Failed;
        }
        finally
        {
            if (IsCurrent(generation))
                StateHasChanged();
        }
    }

    private async Task SetGlobalProject(Project project)
    {
        if (!_appBarProjects.Any(p => p.ProjectId == project.ProjectId))
            return;

        _loadGeneration++;
        ProjectState.SetProject(project);
        if (OrganizationState.SelectedOrganizationId is int organizationId)
            await PersistLatestSelectionAsync(organizationId, project.ProjectId);
    }

    private Task PersistLatestSelectionAsync(int organizationId, int? projectId)
    {
        lock (_selectionPersistenceLock)
        {
            _desiredSelection = new Selection(organizationId, projectId);
            if (!_selectionWriterRunning)
            {
                _selectionWriterRunning = true;
                _selectionWriterTask = RunSelectionWriterAsync(_persistenceGeneration);
            }

            return _selectionWriterTask;
        }
    }

    private async Task RunSelectionWriterAsync(int persistenceGeneration)
    {
        while (true)
        {
            Selection target;
            lock (_selectionPersistenceLock)
            {
                if (_disposed || _desiredSelection is not Selection desired
                    || desired == _persistedSelection)
                {
                    _selectionWriterRunning = false;
                    return;
                }

                persistenceGeneration = _persistenceGeneration;
                target = desired;
            }

            try
            {
                var latest = await Http.GetFromJsonAsync<UserSettingsDto>("api/user/settings")
                    ?? _settings
                    ?? new UserSettingsDto();
                lock (_selectionPersistenceLock)
                {
                    if (persistenceGeneration != _persistenceGeneration)
                        continue;
                    if (_desiredSelection is Selection latestDesired)
                        target = latestDesired;
                }

                var merged = new UserSettingsDto
                {
                    Email = latest.Email,
                    DiscordUsername = latest.DiscordUsername,
                    UiPreference = latest.UiPreference,
                    DefaultOrganizationId = target.OrganizationId,
                    DefaultProjectId = target.ProjectId
                };

                var response = await Http.PutAsJsonAsync("api/user/settings", merged);
                response.EnsureSuccessStatusCode();

                lock (_selectionPersistenceLock)
                {
                    if (persistenceGeneration != _persistenceGeneration)
                        continue;

                    _persistedSelection = target;
                    _settings = merged;
                }
            }
            catch (Exception)
            {
                var retryLatest = false;
                lock (_selectionPersistenceLock)
                {
                    if (persistenceGeneration != _persistenceGeneration)
                        continue;
                    retryLatest = _desiredSelection is Selection desired && desired != target;
                    if (!retryLatest)
                        _selectionWriterRunning = false;
                }

                Snackbar.Add("Unable to save your organization and project selection.", Severity.Error);
                if (!retryLatest)
                    return;
            }
        }
    }

    private bool IsCurrent(int generation) => !_disposed && generation == _loadGeneration;

    private void ClearSession(bool incrementGeneration = true)
    {
        if (incrementGeneration)
            _loadGeneration++;
        _organizations = [];
        _appBarProjects = [];
        _settings = null;
        _isDarkMode = false;
        _userPreferenceLoaded = false;
        lock (_selectionPersistenceLock)
        {
            _persistenceGeneration++;
            _desiredSelection = null;
            _persistedSelection = null;
        }
        OrganizationState.Clear();
        ProjectState.Clear();
    }

    private void ToggleNavMenu()
    {
        _drawerOpen = !_drawerOpen;
    }

    private Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        return Task.CompletedTask;
    }

    private async Task HandleLogout()
    {
        var confirmed = await DialogService.ShowMessageBox(
            title: "Sign Out",
            message: "Are you sure you want to sign out?",
            yesText: "Sign Out",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            ClearSession();
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/login");
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadGeneration++;
        lock (_selectionPersistenceLock)
        {
            _persistenceGeneration++;
            _desiredSelection = null;
        }
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
        ProjectState.OnProjectListChanged -= OnProjectListChanged;
    }

    private readonly record struct Selection(int OrganizationId, int? ProjectId);

    private enum ProjectLoadResult
    {
        Success,
        NotFound,
        Failed
    }
}
