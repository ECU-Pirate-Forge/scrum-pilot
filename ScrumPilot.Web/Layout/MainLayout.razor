@using ScrumPilot.Web.Services
@using ScrumPilot.Shared.Models
@using System.Net.Http.Json
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject HttpClient Http
@inject OrganizationStateService OrganizationState
@inject ProjectStateService ProjectState
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inherits LayoutComponentBase
@implements IDisposable
@using MudBlazor

<MudThemeProvider @ref="@_mudThemeProvider" Theme="currentTheme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudSnackbarProvider />

<MudLayout>
    <div class="appbar-shell">
    <MudAppBar Elevation="1" Fixed="true" Class="tenant-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleNavMenu"
                       aria-label="Toggle navigation menu"
                       Title="Toggle navigation menu" />
        <a href="" class="appbar-logo-link">
            <img src="images/logo.png" alt="ScrumPilot" class="main-logo" />
        </a>
        <MudSpacer />
        @if (_organizations.Any())
        {
            <MudMenu Dense="true" ActivationEvent="MouseEvent.LeftClick" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                <ActivatorContent>
                    <MudButton Color="Color.Inherit"
                               Class="appbar-tenant-button"
                               aria-label="@($"Select organization: {OrganizationState.SelectedOrganization?.Name ?? "none"}")"
                               EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                               StartIcon="@Icons.Material.Filled.Business">
                        <span class="appbar-selection-label">@(OrganizationState.SelectedOrganization?.Name ?? "Select Organization")</span>
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var organization in _organizations)
                    {
                        var item = organization;
                        <MudMenuItem OnClick="@(() => SelectOrganizationAsync(item))">
                            @item.Name
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }
        @if (_appBarProjects.Any())
        {
            <MudMenu Dense="true" ActivationEvent="MouseEvent.LeftClick" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                <ActivatorContent>
                    <MudButton Color="Color.Inherit"
                               Class="appbar-tenant-button appbar-project-button"
                               aria-label="@($"Select project: {ProjectState.SelectedProject?.ProjectName ?? "none"}")"
                               EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                               StartIcon="@Icons.Material.Filled.Folder">
                        <span class="appbar-selection-label">@(ProjectState.SelectedProject?.ProjectName ?? "Select Project")</span>
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var project in _appBarProjects)
                    {
                        var p = project;
                        var isActive = ProjectState.SelectedProjectId == p.ProjectId;
                        <MudMenuItem OnClick="@(() => SetGlobalProject(p))"
                                     Style="@(isActive ? "font-weight: 600;" : "")">
                            @p.ProjectName
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="@ToggleDarkMode"
                       aria-label="Toggle dark mode"
                       Title="Toggle dark mode" />
        <MudIconButton Icon="@Icons.Material.Filled.Person"
                       Color="Color.Inherit"
                       Href="user-settings"
                       aria-label="User settings"
                       Title="User settings" />
        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                       Color="Color.Inherit"
                       OnClick="@HandleLogout"
                       aria-label="Sign out"
                       Title="Sign out" />
    </MudAppBar>
    </div>

    <MudDrawer @bind-Open="@_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Variant="DrawerVariant.Mini"
               Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <div class="content px-4">
            <CascadingValue Value="_isDarkMode" Name="IsDarkMode">
                <CascadingValue @key="_work" Value="_work">
                    <div @key="_work">
                        <MudDialogProvider />
                        @if (_routeLoading || _resolvedUri != Navigation.Uri)
                        {
                            <MudProgressCircular Indeterminate="true" />
                        }
                        else if (_routeError is not null)
                        {
                            <MudAlert Severity="Severity.Error">@_routeError</MudAlert>
                            <MudButton Href="organization-management">Organization directory</MudButton>
                        }
                        else if (_needsOrganization)
                        {
                            <MudAlert Severity="Severity.Info">Choose an organization to open this page. Old project-only links cannot identify an organization.</MudAlert>
                            @foreach (var organization in _organizations.Where(o => !o.IsDeleted))
                            {
                                <MudButton OnClick="@(() => SelectOrganizationAsync(organization))">@organization.Name</MudButton>
                            }
                            <MudButton Href="organization-management">Organization directory</MudButton>
                        }
                        else
                        {
                            @Body
                        }
                    </div>
                </CascadingValue>
            </CascadingValue>
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private bool _userPreferenceLoaded = false;
    private MudThemeProvider? _mudThemeProvider;
    private List<OrganizationSummaryDto> _organizations = [];
    private List<Project> _appBarProjects = new();
    private UserSettingsDto? _settings;
    private int _loadGeneration;
    private CancellationTokenSource? _sessionCancellation;
    private bool _disposed;
    private bool _routeLoading = true;
    private bool _authenticated;
    private string? _routeError;
    private string? _resolvedUri;
    private bool _needsOrganization;
    private WorkScope? _work;
    private bool _applyingRoute;

    MudTheme currentTheme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1b6ec2",
            AppbarBackground = "#1b6ec2",
            Surface = "#ffffff",
            Background = "#f5f7fa",
            TextPrimary = "#212529",
            TextSecondary = "#64748b",
            Divider = "rgba(0,0,0,0.12)",
            LinesDefault = "rgba(0,0,0,0.08)",
            TableLines = "rgba(0,0,0,0.12)",
            TableStriped = "rgba(0,0,0,0.03)",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#1b6ec2",
            Secondary = "#f48fb1",
            AppbarBackground = "#1a1a1a",
            Surface = "#161b22",
            Background = "#0d1117",
            TextPrimary = "#e6edf3",
            TextSecondary = "#8b949e",
            TextDisabled = "#484f58",
            ActionDefault = "#e6edf3",
            ActionDisabled = "#484f58",
            Divider = "#21262d",
            DividerLight = "#21262d",
            TableLines = "#21262d",
            LinesDefault = "#21262d",
            LinesInputs = "#30363d",
            TableStriped = "#1c2128",
            HoverOpacity = 0.07,
            GrayDefault = "#30363d",
            GrayLight = "#484f58",
            GrayLighter = "#6e7681",
            GrayDark = "#21262d",
            GrayDarker = "#161b22"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        ProjectState.OnProjectListChanged += OnProjectListChanged;
        ProjectState.OnChange += OnProjectSelectionChanged;
        Navigation.LocationChanged += OnLocationChanged;
        var authenticationState = await AuthStateProvider.GetAuthenticationStateAsync();
        _authenticated = authenticationState.User.Identity?.IsAuthenticated == true;
        if (_authenticated)
            await LoadSessionAsync();
        else
            ClearSession();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _mudThemeProvider is not null && !_userPreferenceLoaded)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            var state = await task;
            _authenticated = state.User.Identity?.IsAuthenticated == true;
            if (_authenticated)
                await LoadSessionAsync();
            else
            {
                ClearSession();
                StateHasChanged();
            }
        });
    }

    private void OnProjectListChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (_authenticated) await LoadSessionAsync();
            else
            {
                ClearSession();
                StateHasChanged();
            }
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        // Cancel synchronously, before any old continuation can save against a new URL.
        _work?.Dispose();
        _ = InvokeAsync(LoadSessionAsync);
    }

    private void OnProjectSelectionChanged()
    {
        if (_applyingRoute || _disposed || _work is not { IsCurrent: true }) return;
        var uri = new Uri(Navigation.Uri);
        var projectId = ProjectState.SelectedProjectId;
        if (OrganizationRoutes.ProjectId(uri) != projectId)
            Navigation.NavigateTo(OrganizationRoutes.Page(_work.OrganizationId, OrganizationRoutes.CurrentPage(uri), projectId));
    }

    private async Task LoadSessionAsync()
    {
        if (_disposed || !_authenticated) return;
        var generation = ++_loadGeneration;
        _sessionCancellation?.Cancel();
        _sessionCancellation?.Dispose();
        var cancellation = new CancellationTokenSource();
        _sessionCancellation = cancellation;
        _work?.Dispose();
        _work = null;
        _routeLoading = true;
        _routeError = null;
        _needsOrganization = false;
        _appBarProjects = [];
        _applyingRoute = true;
        OrganizationState.Clear();
        ProjectState.Clear();
        _applyingRoute = false;
        var uri = new Uri(Navigation.Uri);
        var organizationId = OrganizationRoutes.OrganizationId(uri);
        var projectId = OrganizationRoutes.ProjectId(uri);
        var isLanding = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', 2)[0].Length == 0;

        try
        {
            var organizations = await Http.GetFromJsonAsync<List<OrganizationSummaryDto>>("api/organizations", cancellation.Token) ?? [];
            if (!IsCurrent(generation)) return;
            _organizations = organizations.Where(o => !o.IsDeleted).ToList();
            if (_settings is null || (isLanding && string.IsNullOrEmpty(uri.Query)))
            {
                _settings = await Http.GetFromJsonAsync<UserSettingsDto>("api/user/settings", cancellation.Token);
                if (!IsCurrent(generation)) return;
                if (_settings is not null)
                {
                    _isDarkMode = _settings.UiPreference == UiPreference.Dark;
                    _userPreferenceLoaded = true;
                }
            }
            // Defaults are only an unqualified landing fallback. Never interpret a local ID
            // in a legacy link using another account preference or the first organization.
            if (isLanding && string.IsNullOrEmpty(uri.Query)
                && _settings?.DefaultOrganizationId is int defaultId)
            {
                Navigation.NavigateTo(OrganizationRoutes.Page(defaultId, "backlog", _settings.DefaultProjectId), replace: true);
                return;
            }
            if (organizationId is null)
            {
                _needsOrganization = OrganizationRoutes.IsLegacyWorkLink(uri)
                    || (isLanding && projectId.HasValue);
                return;
            }
            var organization = _organizations.FirstOrDefault(o => o.OrganizationId == organizationId);
            if (organization is null)
            {
                _routeError = "This organization is unavailable, deleted, or you do not have membership.";
                return;
            }
            // Even GlobalAdmin accounts must pass the work endpoint's membership check.
            var projects = await Http.GetFromJsonAsync<List<Project>>(
                OrganizationRoutes.Api(organizationId.Value, "projects"), cancellation.Token) ?? [];
            if (!IsCurrent(generation)) return;
            var selected = projects.FirstOrDefault(p => p.ProjectId == projectId);
            if (projectId.HasValue && selected is null)
            {
                _routeError = "This project is unavailable or you do not have project access in this organization.";
                return;
            }
            _appBarProjects = projects;
            _applyingRoute = true;
            OrganizationState.SetOrganization(organization);
            ProjectState.SetProject(selected);
            _applyingRoute = false;
            _work = new WorkScope(Http, organizationId.Value, projectId);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (HttpRequestException)
        {
            if (IsCurrent(generation))
            {
                _routeError = "Unable to open this organization. It may be unavailable, or your access may have changed.";
            }
        }
        finally
        {
            if (IsCurrent(generation))
            {
                // The router can replace Body before our LocationChanged handler runs.
                _resolvedUri = uri.AbsoluteUri;
                _routeLoading = false;
                StateHasChanged();
            }
        }
    }

    private Task SelectOrganizationAsync(OrganizationSummaryDto organization)
    {
        var page = OrganizationRoutes.CurrentPage(new Uri(Navigation.Uri));
        if (!OrganizationRoutes.IsWorkPage(new Uri(Navigation.Uri))) page = "backlog";
        // A project ID from the old tenant is never carried to the new tenant.
        Navigation.NavigateTo(OrganizationRoutes.Page(organization.OrganizationId, page));
        return Task.CompletedTask;
    }

    private Task SetGlobalProject(Project project)
    {
        if (_work is not { IsCurrent: true } || !_appBarProjects.Any(p => p.ProjectId == project.ProjectId))
            return Task.CompletedTask;
        var uri = new Uri(Navigation.Uri);
        Navigation.NavigateTo(OrganizationRoutes.Page(_work.OrganizationId, OrganizationRoutes.CurrentPage(uri), project.ProjectId));
        return Task.CompletedTask;
    }

    private bool IsCurrent(int generation) => !_disposed && generation == _loadGeneration;

    private void ClearSession(bool incrementGeneration = true)
    {
        if (incrementGeneration)
            _loadGeneration++;
        _organizations = [];
        _appBarProjects = [];
        _settings = null;
        _routeLoading = false;
        _routeError = null;
        _needsOrganization = false;
        _resolvedUri = Navigation.Uri;
        _isDarkMode = false;
        _userPreferenceLoaded = false;
        _work?.Dispose();
        _work = null;
        _sessionCancellation?.Cancel();
        _sessionCancellation?.Dispose();
        _sessionCancellation = null;
        _applyingRoute = true;
        OrganizationState.Clear();
        ProjectState.Clear();
        _applyingRoute = false;
    }

    private void ToggleNavMenu()
    {
        _drawerOpen = !_drawerOpen;
    }

    private Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        return Task.CompletedTask;
    }

    private async Task HandleLogout()
    {
        var confirmed = await DialogService.ShowMessageBox(
            title: "Sign Out",
            message: "Are you sure you want to sign out?",
            yesText: "Sign Out",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            ClearSession();
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("login");
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadGeneration++;
        _work?.Dispose();
        _sessionCancellation?.Cancel();
        _sessionCancellation?.Dispose();
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
        ProjectState.OnProjectListChanged -= OnProjectListChanged;
        ProjectState.OnChange -= OnProjectSelectionChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
